# Copy to .env and export, or set these in your shell. All have demo defaults.
STOREAPP_DEMO_MODE=1
STOREAPP_DEBUG=0
STOREAPP_DB_NAME=storeapp
STOREAPP_DB_USER=storeapp
STOREAPP_DB_PASSWORD=storeapp
STOREAPP_DB_HOST=127.0.0.1
STOREAPP_DB_PORT=5432
